;; (v comes from a flat `cond` else rather than a labelled continue.)
(defun sum-of-primes (max)
  (let ((total 0))
    (dotimes (i max)
      (dotimes (j i)
        (co nd((zerop (mod i j)) (setf total total))
              (t (incf total i)))))
    total))

;; Cognitive: case(+lauses = 3
(defun get-words (n)
  (case n
    (1 "one")
    (2 "a couple")
    (otherwise "lots")))

;; Cognitive: if(+1); Cyclomatic: base 1 + if + and = 3
(defun classify (a b)
  (if (and a b) "both" "not"))
